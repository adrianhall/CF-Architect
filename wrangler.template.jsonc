// wrangler.template.jsonc
//
// This is the TEMPLATE for wrangler.jsonc. It contains ${TF_OUTPUT_*}
// placeholders that are substituted by `npm run render-wrangler` after
// `npm run provision` writes .terraform-outputs.json.
//
// DO NOT edit wrangler.jsonc directly — it is generated and gitignored.
// Edit this file instead, then re-run `npm run render-wrangler`.
{
  "name": "${TF_OUTPUT_WORKER_NAME}",
  // Path is relative to this file (repo root)
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,

  // ---------------------------------------------------------------------------
  // Static assets — Vite SPA build output
  // ---------------------------------------------------------------------------
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    // Serve index.html for all unmatched routes (SPA client-side routing)
    "not_found_handling": "single-page-application",
    // Only let the Worker see /api/* and /_auth/* — everything else goes
    // straight to ASSETS without hitting the Worker.
    "run_worker_first": ["/api/*", "/_auth/*"],
  },

  // ---------------------------------------------------------------------------
  // D1 database binding
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "${TF_OUTPUT_D1_DATABASE_NAME}",
      "database_id": "${TF_OUTPUT_D1_DATABASE_ID}",
      // Migrations live under apps/worker, not at repo root where this config lives
      "migrations_dir": "./apps/worker/src/db/migrations",
    },
  ],

  // ---------------------------------------------------------------------------
  // KV namespace bindings
  // ---------------------------------------------------------------------------
  "kv_namespaces": [
    {
      "binding": "CF_ARCH_SHARES",
      "id": "${TF_OUTPUT_KV_SHARES_ID}",
    },
    {
      "binding": "CF_ARCH_CATALOG",
      "id": "${TF_OUTPUT_KV_CATALOG_ID}",
    },
  ],

  // ---------------------------------------------------------------------------
  // R2 bucket binding
  // ---------------------------------------------------------------------------
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "${TF_OUTPUT_R2_BUCKET_NAME}",
    },
  ],

  // ---------------------------------------------------------------------------
  // Environment variables available at runtime
  // ---------------------------------------------------------------------------
  "vars": {
    "ENVIRONMENT": "production",
    // Cloudflare Access audience tag — used by cloudflareAccess middleware to
    // validate JWT `aud` claims. Auto-populated by Terraform.
    "CLOUDFLARE_ACCESS_AUD": "${TF_OUTPUT_ACCESS_AUD}",
    // Cloudflare Access team domain — used by cloudflareAccess to fetch the
    // JWKS for validating real (non-dev) Access JWTs. Auto-populated by TF.
    "CLOUDFLARE_TEAM_DOMAIN": "${TF_OUTPUT_CLOUDFLARE_TEAM_DOMAIN}",
  },

  // ---------------------------------------------------------------------------
  // Rate limiting (native Workers ratelimit binding — GA Sept 2025)
  // Limits are per Cloudflare location. See D02 in docs/DECISION_LOG.md.
  // ---------------------------------------------------------------------------
  "ratelimits": [
    {
      "name": "RL_SHARES",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "RL_ADMIN",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      // Autosave limit — binding declared now; wired to the PUT /api/diagrams
      // route in Phase 05 when diagram persistence is added.
      "name": "RL_AUTOSAVE",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
  ],

  // ---------------------------------------------------------------------------
  // Observability
  // ---------------------------------------------------------------------------
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
