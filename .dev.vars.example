# CF-Architect — local development Wrangler secrets
# Copy this file to .dev.vars and fill in the values.
# .dev.vars is gitignored and MUST NOT be committed.
#
# Wrangler reads .dev.vars automatically during `wrangler dev` / `npm start`.
# These values override any [vars] in wrangler.jsonc for local development.

# ---------------------------------------------------------------------------
# Developer auth bypass (LOCAL ONLY)
# ---------------------------------------------------------------------------

# Set to "true" to enable the interactive dev-mode login bypass provided by
# @adrianhall/cloudflare-auth. When set, navigating to /_auth/login in your
# browser prompts for an email address and issues a local CF_Authorization cookie.
#
# IMPORTANT: This variable MUST NOT appear in wrangler.jsonc or be deployed.
# Production fails closed if CLOUDFLARE_TEAM_DOMAIN is unset AND DEV_MODE is absent.
DEV_MODE=true

# Optional: Cloudflare IdP ID to pre-select on the login screen.
# Leave blank to show the default Cloudflare Access login page.
# DEV_IDP_ID=
