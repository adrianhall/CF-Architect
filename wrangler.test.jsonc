// wrangler.test.jsonc
//
// Committed fixture used by:
//   - apps/worker/vitest.config.ts (via poolOptions.wrangler.configPath)
//   - apps/worker/package.json build script (--dry-run in CI)
//
// Contains stub binding IDs so that `@cloudflare/vitest-pool-workers` and
// `wrangler deploy --dry-run` can run without a real Cloudflare account.
//
// DO NOT use this file for production deploys.
// The real wrangler.jsonc is generated by `npm run render-wrangler` and is
// gitignored.
{
  "name": "cf-architect-test",
  // Paths are relative to this file (repo root)
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/_auth/*"],
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-arch-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
  ],

  "kv_namespaces": [
    {
      "binding": "CF_ARCH_SHARES",
      "id": "00000000000000000000000000000002",
    },
    {
      "binding": "CF_ARCH_CATALOG",
      "id": "00000000000000000000000000000003",
    },
  ],

  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "cf-arch-assets-test",
    },
  ],

  "vars": {
    "ENVIRONMENT": "test",
  },
}
