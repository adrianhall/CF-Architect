# CF-Architect — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored and MUST NOT be committed.
# Store the real values in a secrets manager (e.g. 1Password).

# ---------------------------------------------------------------------------
# Cloudflare credentials
# ---------------------------------------------------------------------------

# Your Cloudflare account ID.
# Found at: https://dash.cloudflare.com → right-hand sidebar under "Account ID".
CLOUDFLARE_ACCOUNT_ID=

# API token with permissions to create Workers, D1, KV, and R2 resources.
# Scope: Account > Workers Scripts:Edit, D1:Edit, Workers KV Storage:Edit,
#        R2 Storage:Edit, Worker Routes:Edit.
# Create at: https://dash.cloudflare.com/profile/api-tokens
# This is the PROVISIONING token — broad enough for `terraform apply`.
# A separate deploy-scoped token (Workers Scripts:Edit only) is used in CI.
CLOUDFLARE_API_TOKEN=

# ---------------------------------------------------------------------------
# Application configuration
# ---------------------------------------------------------------------------

# Email address of the first admin user.
# The first user to log in with this email is promoted to role='admin'.
# Required. Must be a valid email address that can authenticate via Cloudflare Access.
SEED_ADMIN_EMAIL=

# Deployment environment name. Used to suffix Cloudflare resource names.
# Defaults to "production" if not set.
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Cloudflare Access configuration (required for production auth)
# ---------------------------------------------------------------------------

# Your Cloudflare Zero Trust team domain (e.g. "myteam.cloudflareaccess.com").
# Required in production. If unset, the Worker fails closed with 401.
# Leave blank for local development (use DEV_MODE in .dev.vars instead).
CLOUDFLARE_TEAM_DOMAIN=

# Cloudflare Access application AUD (audience tag).
# OUTPUT — Terraform writes this after `npm run provision` and injects it
# into wrangler.jsonc via render-wrangler. You do not need to fill this in
# manually; it is populated from infra/outputs.tf → .terraform-outputs.json.
# Leave blank here; it is documented for reference only.
CLOUDFLARE_ACCESS_AUD=

# ---------------------------------------------------------------------------
# Cloudflare Access — domain and policy (required for terraform provisioning)
# ---------------------------------------------------------------------------

# The domain Cloudflare Access should protect.
# For workers.dev deployments, this is:
#   <worker-name>.<account-workers-subdomain>.workers.dev
# For custom domains, use the full domain (wildcards supported, e.g. *.example.com).
#
# NOTE: The workers.dev subdomain is account-specific. To find it:
#   Cloudflare dashboard → Workers & Pages → Overview → your-worker → Settings
#   The workers.dev URL is shown under "Routes".
# If you deploy to a custom domain, set this to that domain instead.
#
# This variable is consumed by Terraform in infra/access.tf. If it is not
# set, `npm run provision` will fail. You may run provision twice:
#   1. First run provisions Worker, D1, KV, R2 → note the workers.dev URL
#   2. Set WORKER_DOMAIN, then re-run provision to create the Access application
WORKER_DOMAIN=

# Email domain to allow through Cloudflare Access (e.g. "example.com").
# Any user whose email ends in @<ALLOWED_EMAIL_DOMAIN> will be permitted.
# Set this to your organisation's email domain.
ALLOWED_EMAIL_DOMAIN=
